        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (stage) (increase(loadgen_connection_failures_total[$__rate_interval]))",
          "legendFormat": "failed {{stage}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (code) (increase(loadgen_disconnects_total[$__rate_interval]))",
          "legendFormat": "closed {{code}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Generator health",
      "description": "The generator's own event loop lag p99 and CPU. When they climb, the generator is the bottleneck and player latency is not trustworthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"load-generator\"}",
          "legendFormat": "event loop p99"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "rate(process_cpu_seconds_total{job=\"load-generator\"}[$__rate_interval])",
          "legendFormat": "cpu (share of a core)"
        }
      ]
    },
