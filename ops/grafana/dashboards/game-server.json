        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, instance, type) (rate(crash_ws_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{type}} {{instance}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
