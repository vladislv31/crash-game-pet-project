      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (type, result) (rate(loadgen_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{type}} {{result}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Bots",
      "description": "Bots the run aims for and bots connected now.",
