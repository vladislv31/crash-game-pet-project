    {
      "id": 5,
      "type": "timeseries",
      "title": "Request duration",
      "description": "From receipt of a bet or cashout message to the response, by type. Does not include time waiting behind a busy event loop.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
