# Copy to apps/game-server/.env to override the defaults (they match docker-compose.yml).
PORT=3000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crash
POSTGRES_PASSWORD=crash
POSTGRES_DB=crash
POSTGRES_TEST_DB=crash_test
# Milliseconds between money reconciliation runs (ADR-0007); 0 turns the schedule off.
RECONCILIATION_INTERVAL_MS=60000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Redis database for integration tests, so they never touch dev data.
REDIS_TEST_DB=1
# Milliseconds between tournament leaderboard broadcasts (ADR-0009).
TOURNAMENT_SNAPSHOT_INTERVAL_MS=2000
# Milliseconds between leaderboard cache rebuilds from PostgreSQL while a tournament runs (ADR-0009).
TOURNAMENT_REBUILD_INTERVAL_MS=60000
