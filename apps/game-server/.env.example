# Copy to apps/game-server/.env to override the defaults (they match docker-compose.yml).
PORT=3000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crash
POSTGRES_PASSWORD=crash
POSTGRES_DB=crash
POSTGRES_TEST_DB=crash_test
# Milliseconds between money reconciliation runs (ADR-0007); 0 turns the schedule off.
RECONCILIATION_INTERVAL_MS=60000
