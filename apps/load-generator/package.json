{
  "name": "load-generator",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start:prod": "node dist/main",
    "start": "ts-node src/main.ts | pino-pretty --singleLine --timestampKey timestamp --messageKey event --ignore service,serviceVersion,commitHash,region,instanceId",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "@crash/contracts": "^0.0.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2"
  }
}
